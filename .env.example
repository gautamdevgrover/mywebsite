# ==============================================================================
# GAUTAM DEV - PRODUCTION ENVIRONMENT TEMPLATE
# Copy this file to .env.local (development) or .env (production server)
# DO NOT commit real values or production secrets into Git!
# ==============================================================================

# Database Connection URL (Optional in development - defaults to local SQLite)
# In production, specify your PostgreSQL connection string
DATABASE_URL=

# Admin Portal Authentication (Credentials for logging into /admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session Encryption Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public Canonical Site URL (e.g. https://gautamdevgrover.online)
NEXT_PUBLIC_SITE_URL=

# Optional: Contact Form Rate Limiting (Submissions allowed per hour per IP, default: 5)
CONTACT_RATE_LIMIT_PER_HOUR=
